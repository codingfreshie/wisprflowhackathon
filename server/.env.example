# ========================================================
# Meeting Sync Agent - Backend Environment Variables
# ========================================================
PORT=5000

# OPTIONAL: Add your Google Gemini API Key or OpenAI API Key
# If left empty, the server automatically uses the built-in
# resilient Wispr Flow Voice NLP & Conflict Engine for offline testing!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternative: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional live Linear sync for Review & Push
# Create a personal API key at https://linear.app/settings/account/security
LINEAR_API_KEY=
# Optional: pin a team. If blank, the first team on the key is used.
LINEAR_TEAM_ID=
